; AmberCity Godot 4: projeto para importar pelo arquivo project.godot.
config_version=5

[application]
config/name="AmberCity - sMax 8K e iMAX 10K"
run/main_scene="res://cidade_expandida.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]
pointing/emulate_mouse_from_touch=false

[physics]
3d/default_gravity=18.0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.57, 0.73, 0.86, 1)


anti_aliasing/quality/msaa_3d=0
scaling_3d/mode=0
textures/default_filters/anisotropic_filtering_level=2
